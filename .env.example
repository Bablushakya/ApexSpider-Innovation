# ══════════════════════════════════════════════════════
# ApexSpider Innovation — Environment Variables
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── EmailJS Configuration (Client-Side Email Service) ──
# Get your credentials from: https://dashboard.emailjs.com
# 1. Create an EmailJS account
# 2. Add an email service connected to info@apexspiderinnovation.com
# 3. Create an email template with the following variables:
#      {{subject}}, {{name}}, {{reply_to}}, {{email}}, {{phone}},
#      {{company}}, {{projectType}}, {{budget}}, {{message}}, {{submitted_at}}
#    Set the template's "To Email"  to: info@apexspiderinnovation.com
#    Set the template's "Reply To"  to: {{reply_to}}
#    Set the template's "Subject"   to: {{subject}}
# 4. Copy your Service ID, Template ID, and Public Key below
# NOTE: VITE_* variables are intentionally public — EmailJS public keys are
#       designed for client-side use. Configure domain restrictions in your
#       EmailJS dashboard for production security.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ── Error Tracking (Optional — Sentry) ──────────────────
# If you want production error tracking:
# 1. Create a free account at https://sentry.io
# 2. Create a new "React" project
# 3. Copy the DSN from: Project Settings → Client Keys (DSN)
# 4. Run: npm install @sentry/react
# 5. Activate the real implementation in src/utils/errorTracking.js
# Leave blank or unset to run without error tracking (safe default).

VITE_SENTRY_DSN=

# ── IndexNow — Bing Search (Server-Side Only) ────────────────────────────────
# CRITICAL: Do NOT add a VITE_ prefix. This variable must NEVER be bundled
# into the React client. It is only read by:
#   - api/indexnow.js  (Vercel serverless function — server-side)
#   - scripts/indexnow.mjs  (local/CI script — server-side Node.js)
#
# How to get your key:
#   1. Go to https://www.bing.com/webmasters → IndexNow → Generate Key
#   2. Copy the generated key
#   3. Add it below (and also set it in Vercel Dashboard → Settings → Environment Variables)
#
# The public verification file public/<key>.txt is intentionally committed
# to Git. IndexNow requires it to be publicly accessible — it is NOT a secret.
# The secret is preventing the key from appearing in the React JS bundle.

INDEXNOW_API_KEY=your_indexnow_key_here

# ── IndexNow Trigger Secret (Optional — for /api/indexnow endpoint security) ─
# A random secret used to authenticate POST requests to /api/indexnow.
# Prevents unauthorized actors from triggering repeated IndexNow submissions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as a GitHub Actions secret: INDEXNOW_TRIGGER_SECRET
# Leave blank to run the endpoint without authentication (not recommended).

INDEXNOW_TRIGGER_SECRET=your_random_secret_here
